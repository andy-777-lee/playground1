# 한국도로공사 공공데이터 API 키 (data.ex.co.kr)
# 미지정 시 "test" 키 사용 (일일 호출량 제한)
EX_API_KEY=test

# 구간단속 카메라 엔드포인트 URL. data.ex.co.kr 의 OpenAPI 목록에서 정확한 이름을 찾아 지정.
# 기본값은 추측값이라 404 가 날 수 있음.
# EX_API_URL=https://data.ex.co.kr/openapi/safetyDriving/<정확한_서비스명>

# (선택) 사내 HTTP 프록시
# HTTP_PROXY=http://proxy.company.com:8080

# (선택) 사내 MITM 프록시로 TLS 인증서 검증이 실패할 때만 1 로 설정
# ALLOW_INSECURE_TLS=1
